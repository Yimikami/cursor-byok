  "description": "Select your configured local BYOK model from Cursor's command palette or status bar.",
  "version": "0.1.0",
  "publisher": "cursor-byok-local",
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/Yimikami/cursor-byok" },
